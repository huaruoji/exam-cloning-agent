# Environment variables
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional administrator-managed OpenAI-compatible endpoints. Private and
# loopback addresses are allowed here, but never in browser-supplied URLs.
# MODEL_LOCAL_ENDPOINTS=[{"name":"ollama","base_url":"http://127.0.0.1:11434/v1","model":"qwen2.5:7b"}]
AUTO_DISCOVER_LOCAL_MODELS=true
